---
import KleponLogo from "./KleponLogo.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/tools", label: "Tools" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<nav
  class="sticky top-0 z-50 flex items-center gap-6 bg-bg/90 px-4 py-4 backdrop-blur sm:px-8"
  style="box-shadow: 0 1px 0 color-mix(in srgb, var(--color-text) 10%, transparent);"
>
  <a href="/" class="mr-auto block text-text">
    <KleponLogo class="h-7 w-auto" />
  </a>

  <div class="hidden items-center gap-6 md:flex">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class={`text-sm font-medium no-underline ${
            currentPath === link.href
              ? "text-accent-700"
              : "text-text/70 hover:text-accent-700"
          }`}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    <a
      href="https://api.klepon.systems/Portal/Login"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden text-sm font-medium text-text/70 no-underline hover:text-accent-700 md:inline-block"
    >
      Login
    </a>
    <a
      href="#"
      class="hidden rounded-full border border-text/15 px-5 py-2.5 text-sm font-semibold text-text no-underline hover:bg-text/5 sm:inline-flex"
    >
      Request Trial
    </a>
    <a
      href="#"
      class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-accent-500"
    >
      <span class="hidden sm:inline">Download Tools</span>
      <span class="sm:hidden">Tools</span>
    </a>

    <details id="mobile-menu" class="relative md:hidden">
      <summary
        aria-label="Menu"
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-text/15 text-text [&::-webkit-details-marker]:hidden"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 top-full z-50 mt-3 flex w-48 flex-col gap-4 rounded-2xl bg-bg p-4 shadow-elev-md"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={currentPath === link.href ? "page" : undefined}
              class={`text-sm font-medium no-underline ${
                currentPath === link.href
                  ? "text-accent-700"
                  : "text-text/70 hover:text-accent-700"
              }`}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="https://api.klepon.systems/Portal/Login"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-text/70 no-underline hover:text-accent-700"
        >
          Login
        </a>
        <a
          href="#"
          class="text-sm font-medium text-text/70 no-underline hover:text-accent-700"
        >
          Request Trial
        </a>
      </div>
    </details>
  </div>
</nav>

<script type="module">
  const menu = document.getElementById("mobile-menu");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (!menu.open) return;
      if (!menu.contains(event.target)) {
        menu.open = false;
      }
    });
  }
</script>
