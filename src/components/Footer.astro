---
import KleponLogo from "./KleponLogo.astro";
import HalftoneDots from "./HalftoneDots.astro";

const columns = [
  {
    heading: "About KLEPON",
    links: [
      { label: "Our Team", href: "/company" },
      { label: "Pricing", href: "#" },
      { label: "Consult With Us", href: "#" },
      { label: "Newsletter", href: "#" },
    ],
  },
  {
    heading: "Tools",
    links: [
      { label: "Fire System Modelling", href: "/tools" },
      { label: "Hydraulic Calculations", href: "/tools" },
      { label: "Pipe Fabrication", href: "/tools" },
      { label: "P&ID Generator", href: "/tools" },
      { label: "Drawing List Tools", href: "/tools" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Tutorials", href: "/tutorials" },
      { label: "Knowledge Base", href: "#" },
      { label: "Case Studies", href: "#" },
      { label: "Company", href: "/company" },
    ],
  },
];

const socials = [
  {
    label: "LinkedIn",
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: "YouTube",
    icon: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  },
  {
    label: "X",
    icon: '<path d="M4 4l16 16M20 4 4 20"/>',
  },
];
---

<footer
  class="relative mt-16 overflow-hidden rounded-t-[2.5rem] bg-brand-navy px-8 pt-14 text-white/90"
>
  <HalftoneDots class="-right-16 -top-24 h-72 w-72" />
  <div class="relative mx-auto max-w-7xl">
    <div class="grid grid-cols-2 gap-8 pb-10 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="mr-auto block text-white">
          <KleponLogo class="h-7 w-auto" />
        </a>
        <p class="mb-1.5 mt-3.5 text-label leading-relaxed text-white/60">
          © Copyright 2026 KLEPON. All rights reserved.
        </p>
        <p class="m-0 text-label leading-relaxed text-white/60">
          Built by fire protection engineers, for engineers.
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <div class="mb-3.5 text-xs font-semibold uppercase tracking-wide text-accent">
              {col.heading}
            </div>
            <div class="flex flex-col gap-2.5 text-sm">
              {col.links.map((link) => (
                <a
                  href={link.href}
                  class="text-white/75 no-underline hover:text-accent"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <hr class="m-0 h-px border-0 bg-white/10" />

    <div class="flex flex-wrap items-center justify-between gap-4 py-5">
      <div class="flex gap-6 text-label">
        <a href="/privacy" class="text-white/70 no-underline hover:text-accent">
          Privacy Policy
        </a>
        <a href="/terms" class="text-white/70 no-underline hover:text-accent">
          Terms of Use
        </a>
        <a
          href="/legal-notice"
          class="text-white/70 no-underline hover:text-accent"
        >
          Legal Notice
        </a>
        <a href="#" class="text-white/70 no-underline hover:text-accent">
          Contact Us
        </a>
      </div>
      <div class="flex gap-4">
        {
          socials.map((s) => (
            <a href="#" aria-label={s.label} class="text-white/55 hover:text-accent">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                set:html={s.icon}
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
