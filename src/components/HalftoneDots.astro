---
import { Image } from "astro:assets";
import halftonePattern from "../assets/img/halftone-white.png";

/**
 * The real klepon-brand stippled dot-circle texture (web/assets/pattern/
 * white.png — white dots, transparent background), used in place of the
 * earlier hand-rolled CSS radial-gradient approximation. The source file
 * is one large gradient-density composition rather than a small seamless
 * tile, so it's cropped via `object-cover` (keeps dots circular, just
 * shows whichever patch of the pattern the box's aspect ratio frames)
 * rather than stretched to fit. Decorative only, so it's aria-hidden; size
 * and position come from the wrapper via `class`.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`pointer-events-none absolute overflow-hidden rounded-full ${className}`}
  style="-webkit-mask-image: radial-gradient(circle, black 55%, transparent 78%); mask-image: radial-gradient(circle, black 55%, transparent 78%); opacity: 0.35;"
  aria-hidden="true"
>
  <Image
    src={halftonePattern}
    alt=""
    width={800}
    class="h-full w-full object-cover"
  />
</div>
