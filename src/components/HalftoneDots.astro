---
/**
 * The stippled dot-circle texture from page 5 of the PDF
 * (Klepon_2026_Huisstijl_v02A) — there it's navy dots on a light card;
 * inverted to white dots here since it's meant to sit on the dark
 * navy/green gradient panels. Decorative only, so it's aria-hidden; size
 * and position come from the wrapper via `class`.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`pointer-events-none absolute rounded-full ${className}`}
  style="background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1.4px, transparent 1.6px); background-size: 9px 9px; -webkit-mask-image: radial-gradient(circle, black 55%, transparent 78%); mask-image: radial-gradient(circle, black 55%, transparent 78%); opacity: 0.35;"
  aria-hidden="true"
>
</div>
