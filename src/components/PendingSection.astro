---
// One "still pending" section within a working-draft legal page. Renders a heading plus a
// visibly distinct (dashed-border) placeholder paragraph, so a reader can tell at a glance
// which sections are real and which are gaps — never the two look the same.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div>
  <h2 class="mb-2 font-heading text-lg font-semibold normal-case text-text">{title}</h2>
  <p
    class="m-0 rounded-md border border-dashed border-divider bg-surface px-4 py-3 text-[13.5px] italic leading-relaxed text-text/60"
  >
    <slot />
  </p>
</div>
