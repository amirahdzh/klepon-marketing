---
import Button from "./Button.astro";
import HalftoneDots from "./HalftoneDots.astro";

const peopleIcon =
  '<circle cx="8" cy="8" r="3.5"/><circle cx="16" cy="8" r="3.5"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M12 14c3.3 0 6 2.7 6 6"/>';
---

<section class="px-8 pb-16">
  <div
    class="relative flex flex-col gap-6 overflow-hidden rounded-[2.5rem] bg-brand-navy p-8 text-white sm:p-10 lg:flex-row lg:items-center lg:justify-between lg:gap-x-12"
  >
    <HalftoneDots class="-right-12 -top-20 h-56 w-56" />
    <div class="relative flex items-center gap-4">
      <svg
        width="80"
        height="80"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="1.5"
        aria-hidden="true"
        set:html={peopleIcon}
      />
      <div>
        <h2 class="mb-1.5 text-[1.5rem] leading-[1.2] text-white">
          Ready to Build Smarter Fire Protection Workflows?
        </h2>
        <p class="m-0 text-body leading-relaxed text-white/75">
          Let's work together to deliver better projects, faster.
        </p>
      </div>
    </div>
    <div class="relative flex shrink-0 flex-wrap gap-3 justify-center">
      <Button
        href="mailto:support@klepon.systems?subject=KLEPON%20Contact%20Request"
        variant="primary"
        size="xl"
        >Contact Us<svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="shrink-0"
        >
          <path d="M5 12h12" stroke-linecap="round" stroke-linejoin="round"
          ></path>
          <path d="m13 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg></Button
      >
      <Button
        href="mailto:support@klepon.systems?subject=KLEPON%20Trial%20Access%20Request"
        variant="secondary"
        size="xl"
        class="border-white/25 text-white hover:bg-white/10"
        >Request Trial Access<svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="shrink-0"
        >
          <path d="M5 12h12" stroke-linecap="round" stroke-linejoin="round"
          ></path>
          <path d="m13 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg></Button
      >
    </div>
  </div>
</section>
