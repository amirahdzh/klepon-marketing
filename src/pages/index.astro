                Hydraulic Engine
              </span>
              <span class="rounded-full border border-white/15 px-3 py-1.5">
                Native Calculation
              </span>
              <span class="rounded-full border border-white/15 px-3 py-1.5">
                Revit-Native
              </span>
            </div>
          </div>

          <!-- <div class="lg:col-span-6" data-anim="hero-image">
            <div class="rounded-[1.75rem] bg-white p-3 shadow-elev-lg sm:p-4">
              <img
                src="/hero.png"
                alt="Revit fire system model screenshot"
                class="aspect-[16/11] w-full rounded-[1.25rem] object-cover"
              />
            </div>
          </div> -->
        </div>
      </div>
    </section>

    <section
      data-reveal
      class="bg-white px-8 py-16 opacity-0 translate-y-8 transition-all duration-700 ease-out [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 sm:px-10 lg:px-14"
    >
      <div
        class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-3 lg:gap-16"
