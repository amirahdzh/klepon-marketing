          />
          <span
            class="pointer-events-none absolute inset-0 flex items-center justify-center text-xs font-extrabold uppercase tracking-widest text-brand-navy sm:text-sm"
          >
            <!-- Klepon -->
          </span>
        </div>
        <div class="lg:col-span-2">
          <span
            class="mb-3 block text-sm font-bold uppercase tracking-wide text-brand-green-700 sm:text-base"
