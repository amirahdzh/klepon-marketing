    <style is:global>
      /* is:global: [data-highlight-mark] lands on the <svg> rendered
         inside the KleponMark child component, which Astro's default
         style scoping (a per-component attribute hash) can't reach —
         only this page's own top-level markup gets that hash.
         Continuous slow spin — the full 7-blade radial mark reads as a
         spinning pinwheel, same technique tried earlier for the hero
         background (that spot ended up going to KleponTriangle instead,
         but the mark itself works well here as the section's own
         moment). */
      @media (prefers-reduced-motion: no-preference) {
        [data-highlight-mark] {
          animation: highlight-mark-spin 48s linear infinite;
        }
      }

      @keyframes highlight-mark-spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
    </style>

    <style is:global>
      /* is:global, not "Astro's normal scoping reaches this fine" like
         the comment used to claim: .wheel-conn/.wheel-dot/.wheel-particle
         are created at runtime via document.createElementNS, so they
         never receive Astro's data-astro-cid-* scope attribute the way
         .wheel-card/.wheel-ring (written directly in this template) do.
         A scoped version of this block silently never matched those
         three classes at all — not just their idle-motion animation, but
         their base fill/stroke color, which is why the connector lines
         turned out to have been invisible (stroke: none) since this
         component's very first runtime-layout rebuild. Confirmed via a
         live computed-style check, not assumed. Every selector below is
         uniquely wheel-* prefixed, so going global carries no real
         collision risk.

         Third rebuild of this component. The first two tried to
         precompute card positions at build time (evenly-spaced, then a
         scaled-percentage port of the reference's angles) and both
         produced overlapping cards once actually screenshotted — the
         reference avoids that with a runtime layout pass that measures
         each card's real rendered box, which a build-time-only approach
         fundamentally can't do. #wheel-frame/#wheel-scaler/#wheel-stage
         and the layout()/fit() functions in the script below are ported
         directly from the reference's own .frame/.scaler/.stage and its
         layout()/fit(), at its real 1180×760 scale — just recolored to
         this site's system and without GSAP (the reveal still runs
         through the site's existing IntersectionObserver convention). */

      .wheel-frame {
        position: relative;
        width: 100%;
      }
      .wheel-scaler {
        position: absolute;
        top: 0;
        left: 50%;
        width: 1180px;
        height: 760px;
        transform-origin: top center;
      }
      .wheel-stage {
        position: absolute;
        inset: 0;
      }
      .wheel-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }

      .wheel-ring {
        fill: none;
        stroke-width: 6;
        stroke-linecap: round;
        stroke-opacity: 0.5;
        transition: stroke-dashoffset 700ms ease-out;
      }
      .wheel-conn {
        fill: none;
        stroke: color-mix(in srgb, var(--color-brand-navy) 20%, transparent);
        stroke-width: 2;
        transition: stroke-dashoffset 500ms ease-out;
      }
      .wheel-frame.is-visible .wheel-ring,
      .wheel-frame.is-visible .wheel-conn {
        stroke-dashoffset: 0 !important;
      }

      .wheel-hubdisc {
        fill: var(--color-brand-bg);
        stroke: color-mix(in srgb, var(--color-brand-navy) 15%, transparent);
        stroke-width: 2;
        opacity: 0;
        transform-origin: 590px 380px;
        transform: scale(0.8);
        transition:
          opacity 400ms ease-out,
          transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .wheel-pipe path {
        fill: none;
        stroke: var(--color-brand-green-600);
        stroke-width: 5.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .wheel-nodes rect {
        fill: var(--color-brand-green-600);
      }
      .wheel-pipe,
      .wheel-nodes {
        opacity: 0;
        transform-origin: 590px 380px;
        transform: scale(0.8);
        transition:
          opacity 400ms ease-out 80ms,
          transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 80ms;
      }
      .wheel-frame.is-visible .wheel-hubdisc,
      .wheel-frame.is-visible .wheel-pipe,
      .wheel-frame.is-visible .wheel-nodes {
        opacity: 1;
        transform: scale(1);
      }

      .wheel-dot {
        opacity: 0;
        transform-origin: center;
        transform: scale(0);
        transition:
          opacity 300ms ease-out,
          transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .wheel-frame.is-visible .wheel-dot {
        opacity: 1;
        transform: scale(1);
      }

      /* ---- idle-state ambient motion (rings orbiting, hub breathing) —
         the reference's "Phase 2" loops (minus its particle flow and dot
         twinkle, both removed after review), ported to plain CSS
         @keyframes instead of GSAP's repeat:-1 tweens. Only starts once
         .is-visible is set (an animation-delay long enough to clear the
         entrance transition first, so the two don't fight over
         `transform` mid-handoff), and only under prefers-reduced-motion:
         no-preference. ---- */
      @media (prefers-reduced-motion: no-preference) {
        .wheel-frame.is-visible .wheel-ring {
          animation: wheel-ring-spin-a 64s linear infinite;
          animation-delay: 700ms;
          transform-box: view-box;
          transform-origin: 590px 380px;
        }
        .wheel-frame.is-visible .wheel-ring:nth-child(2) {
          animation-name: wheel-ring-spin-b;
          animation-duration: 88s;
        }
        .wheel-frame.is-visible .wheel-ring:nth-child(3) {
          animation-name: wheel-ring-spin-a;
          animation-duration: 120s;
        }
        @keyframes wheel-ring-spin-a {
          from {
            rotate: 0deg;
          }
          to {
            rotate: 360deg;
          }
        }
        @keyframes wheel-ring-spin-b {
          from {
            rotate: 0deg;
          }
          to {
            rotate: -360deg;
          }
        }

        .wheel-frame.is-visible .wheel-hub {
          animation: wheel-hub-breathe 2.4s ease-in-out infinite alternate;
          animation-delay: 700ms;
        }
        @keyframes wheel-hub-breathe {
          from {
            transform: translateY(0) scale(1);
          }
          to {
            transform: translateY(-7px) scale(1);
          }
        }
      }

      .wheel-hub {
        position: absolute;
        width: 66px;
        height: 66px;
        margin: -33px 0 0 -33px;
        z-index: 3;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: var(--color-brand-navy);
        color: #fff;
        font-weight: 900;
        font-size: 32px;
        box-shadow: var(--shadow-elev-md);
        opacity: 0;
        transform: scale(0.5);
        transition:
          opacity 400ms ease-out 100ms,
          transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1) 100ms;
      }
      .wheel-frame.is-visible .wheel-hub {
        opacity: 1;
        transform: scale(1);
      }

      .wheel-tag {
        position: absolute;
        z-index: 4;
        white-space: nowrap;
        border-radius: 9999px;
        padding: 5px 12px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #fff;
        box-shadow: var(--shadow-elev-sm);
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.6);
        transition:
          opacity 350ms ease-out,
          transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .wheel-frame.is-visible .wheel-tag {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }

      .wheel-card {
        position: absolute;
        z-index: 4;
        width: 250px;
        padding: 14px 16px 15px;
        background: #fff;
        border: 1px solid
          color-mix(in srgb, var(--color-brand-navy) 10%, transparent);
        border-left: 3px solid var(--color-brand-green-600);
        border-radius: 14px;
        box-shadow: var(--shadow-elev-md);
        cursor: default;
        opacity: 0;
        /* --ox/--oy (set per-card via JS, from its own spoke angle) push
           the starting point outward; converging to 0 on reveal is what
           makes it read as flying in toward its docked position, not
           just fading up where it already sits. */
        transform: translate(var(--ox, 0), var(--oy, 0)) scale(0.85);
        transition:
          opacity 500ms ease-out,
          transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1),
          box-shadow 250ms ease-out,
          border-left-width 250ms ease-out;
      }
      .wheel-card.wheel-card-lg {
        width: 360px;
      }
      .wheel-frame.is-visible .wheel-card {
        opacity: 1;
        transform: translate(0, 0) scale(1);
      }
      .wheel-card-eyebrow {
        margin: 0 0 6px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--color-brand-navy) 45%, transparent);
      }
      .wheel-card-title {
        margin: 0;
        font-weight: 900;
        letter-spacing: -0.01em;
        line-height: 1.02;
        font-size: 22px;
        text-transform: uppercase;
        color: var(--color-brand-navy);
      }
      .wheel-card-lg .wheel-card-title {
        font-size: 32px;
      }
      .wheel-card-items {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 11px 0 0;
        padding: 0;
      }
      .wheel-card-items li {
        font-size: 11px;
        font-weight: 500;
        color: color-mix(in srgb, var(--color-brand-navy) 70%, transparent);
        background: var(--color-brand-bg);
        border: 1px solid
          color-mix(in srgb, var(--color-brand-navy) 10%, transparent);
        border-radius: 6px;
        padding: 5px 9px;
      }

      /* Expand-on-hover: transform-only (scale), not a real width/height
         change — the card's box is what the runtime layout pass in the
         script below measured to dock its connector/dot/tag, so growing
         the actual layout size here would leave those docked to the old,
         smaller edge. A transform doesn't affect layout or siblings, so
         it can't desync from the dock points or push neighboring cards.
         Chained onto .wheel-frame.is-visible so it composes with (rather
         than replaces) the entrance's translate(0,0), and given its own
         faster transition so hover feels snappy instead of inheriting
         the entrance's slower bounce-in easing. (Previously scoped as
         ".wheel .wheel-card:hover" — ".wheel" isn't a class used
         anywhere on this element's ancestors, so that half of the rule
         never matched; fixed to target the card directly.) */
      .wheel-frame.is-visible .wheel-card:hover,
      .wheel-frame.is-visible .wheel-card:focus-visible {
        z-index: 10;
        box-shadow: var(--shadow-elev-lg);
        border-left-width: 5px;
        transform: translate(0, 0) scale(1.06);
        transition:
          transform 200ms ease-out,
          box-shadow 200ms ease-out,
          border-left-width 200ms ease-out;
      }
      @media (hover: hover) {
        .wheel-frame:has(.wheel-card:hover) .wheel-card:not(:hover),
        .wheel-frame:has(.wheel-card:hover) .wheel-tag {
          opacity: 0.4;
          transition: opacity 250ms ease-out;
        }
        .wheel-frame:has(.wheel-card:hover) .wheel-conn,
        .wheel-frame:has(.wheel-card:hover) .wheel-dot,
        .wheel-frame:has(.wheel-card:hover) .wheel-ring {
          opacity: 0.3;
          transition: opacity 250ms ease-out;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .wheel-ring,
        .wheel-conn {
          transition: none;
        }
        .wheel-hubdisc,
        .wheel-pipe,
        .wheel-nodes,
        .wheel-dot {
          transition: none;
          opacity: 1;
          transform: scale(1);
        }
        .wheel-hub {
          transition: none;
          opacity: 1;
          transform: scale(1);
        }
        .wheel-tag {
          transition: none;
          opacity: 1;
          transform: translate(-50%, -50%) scale(1);
        }
        .wheel-card {
          transition: none;
          opacity: 1;
          transform: scale(1);
        }
      }
    </style>

    <script>
      import gsap from "gsap";

      // Homepage-only hero entrance sequence, GSAP core (no ScrollTrigger) —
      // one orchestrated moment on load rather than scroll-linked reveals on
      // every section.
      //
      // Deliberately NOT using gsap.matchMedia() here: its .add() callback
      // only fires while the given query currently matches (verified against
      // gsap@3.15.0 — a query that's false at call time never invokes its
      // callback at all, silently). matchMedia is the right tool when you
      // need re-registration on resize; a one-shot reduced-motion check on
      // load is simpler and more reliably done with a plain matchMedia read.
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const duration = reduceMotion ? 0 : 0.7;
      const ease = "power2.out";

      const tl = gsap.timeline({ defaults: { duration, ease } });

      // Background triangle settles in alongside the copy (position 0 —
      // same start time), not before or after it, so it reads as one
      // combined entrance rather than the shape animating on its own.
      const heroTriangle = document.querySelector(
        '[data-anim="hero-triangle"]',
      );
      if (heroTriangle) {
        tl.from(
          heroTriangle,
          {
            opacity: 0,
            scale: 0.92,
            duration: reduceMotion ? 0 : 1.1,
            ease: "power2.out",
          },
          0,
        );
      }

      const copyChildren = document.querySelectorAll(
        '[data-anim="hero-copy"] > *',
      );
      if (copyChildren.length) {
        tl.from(copyChildren, { y: 20, opacity: 0, stagger: 0.1 });
      }

      const heroImage = document.querySelector('[data-anim="hero-image"]');
      if (heroImage) {
        tl.from(
          heroImage,
          { y: 20, opacity: 0, scale: 0.98 },
          reduceMotion ? undefined : "<0.1",
        );
      }

      // Capability wheel ("Single Source of Truth"): a vanilla-JS port of
      // the reference prototype's own layout()/fit() — no GSAP. Runtime
      // measurement (card.offsetWidth/offsetHeight) is the actual reason
      // the reference's cards never overlap despite four of them sharing
      // only a ~142° arc; a build-time-only approach can't know real
      // rendered sizes, which is what broke the two earlier attempts at
      // this component once they were actually screenshotted.
      (function initCapabilityWheel() {
        const frame = document.getElementById(
          "wheel-frame",
        ) as HTMLElement | null;
        if (!frame) return;

        const scaler = document.getElementById(
          "wheel-scaler",
        ) as HTMLElement | null;
        const gConns = document.getElementById(
          "wheel-conns",
        ) as SVGGElement | null;
        const gDots = document.getElementById(
          "wheel-dots",
        ) as SVGGElement | null;
        if (!scaler || !gConns || !gDots) return;

        const NS = "http://www.w3.org/2000/svg";

        const CX = 590;
        const CY = 380;
        const HUB_R = 138; // where connectors leave the hub
        const CARD_R = 262; // how far out the cards anchor

        const polar = (r: number, deg: number) => {
          const a = (deg * Math.PI) / 180;
          return [CX + r * Math.cos(a), CY + r * Math.sin(a)] as const;
        };

        const armDraw = (el: SVGPathElement | SVGCircleElement) => {
          const length = el.getTotalLength();
          el.setAttribute("stroke-dasharray", String(length));
          el.setAttribute("stroke-dashoffset", String(length));
        };

        // One connector + dot per card, built the same way the reference
        // does — dynamically, docked to that card's own angle.
        const spokes = Array.from(
          document.querySelectorAll(".wheel-card") as NodeListOf<HTMLElement>,
        ).map((card) => {
          const conn = document.createElementNS(NS, "path") as SVGPathElement;
          conn.setAttribute("class", "wheel-conn");
          gConns.appendChild(conn);

          const dot = document.createElementNS(
            NS,
            "circle",
          ) as SVGCircleElement;
          dot.setAttribute("class", "wheel-dot");
          dot.setAttribute("r", "7");
          dot.setAttribute("fill", "var(--color-brand-green-600)");
          gDots.appendChild(dot);

          const tag = document.querySelector(
            `.wheel-tag[data-for="${card.dataset.id}"]`,
          ) as HTMLElement | null;

          return {
            card,
            conn,
            dot,
            tag,
            angle: Number(card.dataset.angle),
          };
        });

        // --ox/--oy: how far outward, along this card's own spoke, the
        // entrance transition starts from — the card converges in toward
        // its real (docked) position rather than just fading up in
        // place. Set once, from angle alone, so it doesn't need to wait
        // on layout()'s per-card measurements.
        spokes.forEach((s) => {
          const a = (s.angle * Math.PI) / 180;
          s.card.style.setProperty("--ox", `${Math.cos(a) * 44}px`);
          s.card.style.setProperty("--oy", `${Math.sin(a) * 44}px`);
        });

        // Place each card from its angle, then dock its connector/dot/tag
        // to it — ported directly from the reference's layout(), same
        // branching per direction so the connector always meets whichever
        // edge actually faces the hub.
        function layout() {
          spokes.forEach((s) => {
            const a = (s.angle * Math.PI) / 180;
            const dx = Math.cos(a);
            const dy = Math.sin(a);
            const w = s.card.offsetWidth;
            const h = s.card.offsetHeight;
            const [ax, ay] = polar(CARD_R, s.angle);
            let left: number;
            let top: number;
            let inner: [number, number];

            if (dx > 0.28) {
              left = ax + 14;
              top = ay - h / 2;
              inner = [left, top + h / 2];
            } else if (dx < -0.28) {
              left = ax - 14 - w;
              top = ay - h / 2;
              inner = [left + w, top + h / 2];
            } else if (dy < 0) {
              left = ax - w / 2;
              top = ay - h - 14;
              inner = [left + w / 2, top + h];
            } else {
              left = ax - w / 2;
              top = ay + 14;
              inner = [left + w / 2, top];
            }
            left = Math.max(6, Math.min(left, 1180 - w - 6));
            top = Math.max(6, Math.min(top, 760 - h - 6));
            s.card.style.left = `${left}px`;
            s.card.style.top = `${top}px`;

            const p0 = polar(HUB_R, s.angle);
            const p1 = inner;
            s.conn.setAttribute(
              "d",
              `M ${p0[0].toFixed(1)} ${p0[1].toFixed(1)} L ${p1[0].toFixed(1)} ${p1[1].toFixed(1)}`,
            );

            const lerp = (t: number) =>
              [
                p0[0] + (p1[0] - p0[0]) * t,
                p0[1] + (p1[1] - p0[1]) * t,
              ] as const;
            const dotPos = lerp(0.42);
            const tagPos = lerp(0.72);
            s.dot.setAttribute("cx", String(dotPos[0]));
            s.dot.setAttribute("cy", String(dotPos[1]));
            if (s.tag) {
              s.tag.style.left = `${tagPos[0]}px`;
              s.tag.style.top = `${tagPos[1]}px`;
            }
          });
        }

        // Scale the fixed 1180×760 stage down to whatever width the
        // section actually has (never up — 1180 is the ceiling).
        function fit() {
          if (!frame || !scaler) return;

          const scale = Math.min(1, frame.clientWidth / 1180);
          scaler.style.transform = `translateX(-50%) scale(${scale})`;
          frame.style.height = `${760 * scale}px`;
        }

        layout();
        // Arm the draw-on AFTER layout has given every path its real `d`
        // — getTotalLength() needs an actual path to measure. Only once:
        // resize below re-runs layout()/fit() but deliberately doesn't
        // re-arm, so an already-revealed connector just reflows to its
        // new dock point instead of replaying the draw-in.
        Array.from(
          document.querySelectorAll(
            ".wheel-ring",
          ) as NodeListOf<SVGPathElement>,
        ).forEach(armDraw);
        spokes.forEach((s) => armDraw(s.conn));
        fit();

        window.addEventListener("resize", () => {
          layout();
          fit();
        });
      })();

      // Scroll-triggered reveal for [data-reveal] rows (currently just
      // the Solutions list). Keep the animation tied to the viewport so it
      // replays when each row re-enters view while scrolling back upward or
      // downward again. Separate from the GSAP timeline above: that's a
      // one-shot load animation for the hero; this is IntersectionObserver +
      // a plain CSS transition (opacity/translate, toggled via .is-visible).
      const revealTargets = document.querySelectorAll(
        "[data-reveal]",
      ) as NodeListOf<HTMLElement>;
      if (revealTargets.length) {
        if (reduceMotion) {
          revealTargets.forEach((el) => el.classList.add("is-visible"));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                // isIntersecting is true the instant any pixel is visible
                // and false only once the element is fully offscreen — the
                // previous "-10% 0px" bottom rootMargin shrank the
                // observed area, so a still-fully-visible section sitting
                // in that bottom 10% band would get marked "not
                // intersecting" and fade back to its hidden state while
                // still on screen. threshold 0 + no rootMargin ties
                // is-visible strictly to "fully gone from view" instead.
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                } else {
                  entry.target.classList.remove("is-visible");
                }
              }
            },
            { threshold: 0, rootMargin: "0px" },
          );
          revealTargets.forEach((el) => revealObserver.observe(el));
        }
      }
    </script>
  </div></Layout
>
