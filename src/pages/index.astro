---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import HalftoneDots from "../components/HalftoneDots.astro";
import KleponMark from "../components/KleponMark.astro";
import KleponTriangle from "../components/KleponTriangle.astro";

const highlights = [
  {
    title: "Connected Data",
    body: "From one Revit model to every output. One data source, fully connected.",
  },
  {
    title: "Accurate",
    body: "Structured data for better decisions, verified by design.",
  },
  {
    title: "Construction-Ready",
    body: "Reliable information from design to site, ready for real project delivery.",
  },
];

const solutions = [
  {
    title: "Fire System Modelling Tools",
    body: "Create, manage, and improve Revit-based fire protection models with tools designed to reduce repetitive actions, improve consistency, and speed up daily modelling work.",
    image: "/Fire system modeling tools.png",
  },
  {
    title: "Interactive Hydraulic Calculations",
    body: "Work with model-based hydraulic data, demand points, pipe networks, and calculation-ready information in a more visual and connected workflow.",
    image: "/Interactive Hydraulic Calculations.png",
  },
  {
    title: "Pipe Fabrication and Procurement Tools",
    body: "Generate structured pipe data, prefab outputs, material lists, and procurement information directly from the model to support construction-ready delivery.",
    image: "/Pipe fabrication and procurement tools.png",
  },
  {
    title: "P&ID Generator",
    body: "Create clearer system diagrams and project documentation using automated workflows linked to real engineering data.",
    image: "/P&ID generator.png",
  },
];

const features = [
  {
    number: "01",
    numberColor: "text-brand-green-300",
    title: "Create one reliable source of project data",
    body: "Structure fire protection design information inside the Revit model, so drawings, schedules, calculations, material lists, prefab data, and project outputs can flow from the same source.",
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
  },
  {
    number: "02",
    numberColor: "text-brand-green-200",
    title: "Reduce repetitive modelling",
    body: "Automate common Revit tasks and reduce the time spent on manual input, duplicated data, and disconnected project information.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  },
  {
    number: "03",
    numberColor: "text-brand-green-300",
    title: "Improve engineering accuracy",
    body: "Use structured model data and controlled workflows to reduce mistakes, rework, and inconsistencies between drawings, schedules, reports, and downstream outputs.",
    icon: '<path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    number: "04",
    numberColor: "text-brand-green-200",
    title: "Connect design to delivery",
    body: "Turn model data into practical information for engineering, procurement, fabrication, installation, handover, and future maintenance workflows.",
    icon: '<path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.5-1.5"/>',
  },
];

const downloadIcon =
  '<path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path>';
const arrowIcon = '<path d="M5 12h12"></path><path d="m13 6 6 6-6 6"></path>';
---

<Layout title="KLEPON — Fire Design Tools for Revit">
  <div class="w-full bg-brand-bg font-brand">
    <Nav />

    <section id="hero" class="px-0 pb-0 pt-0">
      <div
        data-spotlight-zone
        class="group relative flex min-h-[95vh] flex-col justify-center overflow-hidden rounded-none bg-brand-navy px-8 pb-8 pt-24 sm:px-10 sm:pb-12 sm:pt-28 lg:px-14 lg:pb-16 lg:pt-32"
      >
        <div
          class="pointer-events-none absolute inset-0 overflow-hidden"
          aria-hidden="true"
        >
          <!-- <KleponMark
            data-hero-mark
            class="absolute -right-[22%] -top-[0%] hidden h-[100%] w-auto text-brand-green lg:block"
          /> -->
          <KleponTriangle
            shine
            data-anim="hero-triangle"
            class="absolute -top-[38%] left-[50%] hidden h-[165%] w-auto rotate-220 text-brand-green lg:block"
          />
          <!-- <HalftoneDots class="-right-100 -top-24 h-400 w-400" /> -->
          <div
            data-cursor-glow
            class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background: radial-gradient(circle 380px at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--color-brand-green) 40%, transparent) 0%, transparent 70%);"
          >
          </div>
        </div>
        <div
          class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-x-14"
        >
          <div class="lg:col-span-6" data-anim="hero-copy">
            <span
              class="mb-2.5 block text-label font-bold uppercase tracking-wide text-accent-200"
            >
              Built by engineers with decades of real project experience
            </span>
            <h1
              class="mb-5 text-[2.25rem] font-extrabold leading-[1.5] tracking-tight text-white uppercase"
            >
              The <span class="text-brand-amber">smarter</span> way to design fire
              protection in Revit
            </h1>
            <p
              class="mb-7 max-w-[52ch] text-base leading-relaxed text-white/75"
            >
              KLEPON develops practical Revit tools that help fire protection
              engineering teams design faster, automate repetitive work, and
              turn their models into accurate, construction-ready information.
            </p>
            <div class="grid gap-3 sm:flex sm:flex-wrap sm:items-center">
              <Button variant="primary" class="w-full text-white sm:w-auto">
                Request Trial Access
              </Button>
              <Button
                variant="secondary"
                class="w-full border-white/25 text-white hover:bg-white/10 sm:w-auto"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={downloadIcon}
                />
                Download KLEPON Tools
              </Button>
            </div>
          </div>

          <!-- <div class="lg:col-span-6" data-anim="hero-image">
            <div class="rounded-[1.75rem] bg-white p-3 shadow-elev-lg sm:p-4">
              <img
                src="/hero.png"
                alt="Revit fire system model screenshot"
                class="aspect-[16/11] w-full rounded-[1.25rem] object-cover"
              />
            </div>
          </div> -->
        </div>
      </div>
    </section>

    <section
      data-reveal
      class="bg-white px-8 py-12 opacity-0 translate-y-8 transition-all duration-700 ease-out [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 lg:py-8"
    >
      <div
        class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 sm:grid-cols-2 lg:grid-cols-[auto_1fr_1fr_1fr] lg:gap-12"
      >
        <div class="flex items-center justify-start gap-3 sm:justify-start">
          <KleponMark
            data-highlight-mark
            class="h-16 w-auto text-brand-green sm:h-24"
          />
          <span
            class="text-2xl sm:text-3xl font-extrabold tracking-wide text-brand-navy lg:hidden"
          >
            KLEPON
          </span>
        </div>
        {
          highlights.map((h, i) => (
            <div
              class={`${i > 0 ? "border-brand-navy/10 border-t pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0" : ""}`}
            >
              <div class="mb-2 text-xl font-extrabold text-brand-navy">
                {h.title}
              </div>
              <p class="m-0 text-body leading-relaxed text-brand-navy/70">
                {h.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="px-8 py-16">
      <div class="mx-auto mb-14 max-w-6xl text-left">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          Solutions
        </span>
        <h2
          class="mb-3 max-w-lg text-[2rem] font-extrabold leading-[1.3] text-brand-navy"
        >
          Practical Fire Design Tools Built by <span
            class="text-brand-green-700">Engineers</span
          >, for <span class="text-brand-green-700">Engineers</span>
        </h2>
        <p class="max-w-2xl text-body leading-[1.9] text-brand-navy/75">
          Created and refined by people who work with fire protection design
          every day, KLEPON solutions are built around real project workflows —
          not generic software assumptions.
        </p>
      </div>

      <div class="mx-auto flex max-w-5xl flex-col gap-16">
        {
          solutions.map((s, i) => (
            <div
              data-reveal
              style={`transition-delay: ${i * 100}ms`}
              class={`flex flex-col items-start gap-8 opacity-0 translate-y-8 transition-all duration-700 ease-out [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 lg:gap-14 ${
                i % 2 === 1 ? "lg:flex-row-reverse" : "lg:flex-row"
              }`}
            >
              <div class="w-full lg:w-1/2">
                <div class="flex items-center justify-center rounded-[2rem]  p-8">
                  <img
                    src={s.image}
                    alt={s.title}
                    class="aspect-[5/4] w-full max-w-sm object-contain"
                  />
                </div>
              </div>
              <div class="w-full lg:w-1/2">
                <span class="mb-3 inline-flex h-7 items-center justify-center rounded-full bg-brand-amber px-3 text-xs font-bold text-brand-navy">
                  0{i + 1}
                </span>
                <div class="mb-2 text-lg font-bold text-brand-navy">
                  {s.title}
                </div>
                <p class="m-0 max-w-[56ch] text-body leading-relaxed text-brand-navy/70">
                  {s.body}
                </p>
                <Button
                  href="/tools"
                  variant="primary"
                  size="sm"
                  class="mt-5 text-white no-underline hover:text-white hover:no-underline"
                >
                  Learn More
                </Button>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="grid grid-cols-1 items-center gap-10 px-8 py-16 md:grid-cols-12 md:gap-x-16"
    >
      <div class="md:col-span-6">
        <img
          src="/wordcloud.png"
          alt="Word cloud of KLEPON's core values: one source of truth, connected, accurate, construction-ready, efficient"
          class="w-full rounded-[2rem] object-cover"
        />
      </div>

      <div class="md:col-span-6">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          Single Source of Truth
        </span>
        <h2 class="mb-4 text-[2rem] font-extrabold text-brand-navy">
          One Model. Connected Project Data.
        </h2>
        <p
          class="mb-3.5 max-w-[60ch] text-body leading-relaxed text-brand-navy/75"
        >
          KLEPON helps fire protection teams turn the Revit design model into a
          single shared source of project information — creating clearer
          visuals, structured data, and practical outputs for everyone involved.
        </p>
        <p
          class="mb-3.5 max-w-[60ch] text-body leading-relaxed text-brand-navy/75"
        >
          Instead of each team working from separate pieces of information,
          KLEPON helps design data flow from the model into the wider project
          workflow.
        </p>
        <p class="max-w-[60ch] text-body leading-relaxed text-brand-navy/75">
          From early client requirements to design, coordination, approval,
          procurement, installation, handover, and maintenance, KLEPON helps
          each stakeholder work from a clearer understanding of the fire system.
        </p>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-10 px-8 py-16">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          Feature highlights
        </span>
        <h2 class="mb-4 text-[2rem] font-extrabold text-brand-navy">
          Connected Workflows from One Data Source
        </h2>
        <p
          class="mx-auto max-w-[56ch] text-base leading-relaxed text-brand-navy/70"
        >
          The workflow is built around one reliable data source so your team can
          work faster, with less rework, and deliver with confidence.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          features.slice(0, 1).map((f) => (
            <div class="rounded-3xl bg-white p-5 shadow-sm">
              <div class="mb-3.5 flex items-center gap-3">
                <span class={`text-[2.125rem] font-extrabold ${f.numberColor}`}>
                  {f.number}
                </span>
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-brand-green-700)"
                  stroke-width="1.5"
                  set:html={f.icon}
                />
              </div>
              <h3 class="mb-2 text-lg font-bold text-brand-navy">{f.title}</h3>
              <p class="m-0 text-sm leading-relaxed text-brand-navy/70">
                {f.body}
              </p>
            </div>
          ))
        }

        <div
          class="hidden overflow-hidden rounded-3xl bg-white shadow-sm lg:block"
        >
          <img
            src="/feature.jpg"
            alt="Team reviewing fire protection data"
            class="h-full w-full object-cover"
          />
        </div>

        {
          features.slice(1).map((f) => (
            <div class="rounded-3xl bg-white p-5 shadow-sm">
              <div class="mb-3.5 flex items-center gap-3">
                <span class={`text-[2.125rem] font-extrabold ${f.numberColor}`}>
                  {f.number}
                </span>
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-brand-green-700)"
                  stroke-width="1.5"
                  set:html={f.icon}
                />
              </div>
              <h3 class="mb-2 text-lg font-bold text-brand-navy">{f.title}</h3>
              <p class="m-0 text-sm leading-relaxed text-brand-navy/70">
                {f.body}
              </p>
            </div>
          ))
        }

        <div
          class="flex flex-col justify-between gap-4 rounded-3xl bg-brand-green-100 p-6 text-center shadow-sm"
        >
          <div class="space-y-4">
            <div
              class="flex flex-col items-center gap-3 sm:flex-row sm:justify-between sm:text-left"
            >
              <div class="min-w-0">
                <h3 class="text-xl font-bold text-brand-navy">
                  Contact for an online demonstration
                </h3>
                <p
                  class="mx-auto mt-2 max-w-[34rem] text-sm leading-relaxed text-brand-navy/75 sm:mx-0"
                >
                  See a live walkthrough of KLEPON in action and learn how it
                  keeps Revit model data connected across design, coordination,
                  and delivery.
                </p>
              </div>
            </div>
          </div>
          <Button variant="primary" class="mx-auto w-full text-white sm:w-auto">
            Contact Us
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="shrink-0"
              set:html={arrowIcon}
            />
          </Button>
        </div>
      </div>
    </section>

    <section
      class="relative mx-8 mb-16 grid grid-cols-1 items-center gap-8 overflow-hidden rounded-[2.5rem] bg-brand-gradient-rtl p-8 md:grid-cols-12"
    >
      <div class="relative md:col-span-5">
        <img
          src="/kleponlaptop.png"
          alt="Laptop showing KLEPON tools"
          class="w-full rounded-[1.5rem] object-cover"
        />
      </div>
      <div class="relative md:col-span-7">
        <h2 class="mb-3.5 text-[1.625rem] font-extrabold text-white">
          Build Smarter Fire Protection Workflows
        </h2>
        <p class="mb-6 max-w-[56ch] text-body leading-relaxed text-white/75">
          Automate repetitive work, connect your workflows, and save countless
          hours of engineering time.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button variant="primary" class="text-white"
            >Request Trial Access</Button
          >
          <a
            href="#"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-8 py-3.5 font-brand text-base font-semibold text-white no-underline hover:bg-white/10"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={downloadIcon}
            />
            Download KLEPON Tools
          </a>
        </div>
      </div>
    </section>

    <Footer />

    <style is:global>
      /* is:global: [data-highlight-mark] lands on the <svg> rendered
         inside the KleponMark child component, which Astro's default
         style scoping (a per-component attribute hash) can't reach —
         only this page's own top-level markup gets that hash.
         Continuous slow spin — the full 7-blade radial mark reads as a
         spinning pinwheel, same technique tried earlier for the hero
         background (that spot ended up going to KleponTriangle instead,
         but the mark itself works well here as the section's own
         moment). */
      @media (prefers-reduced-motion: no-preference) {
        [data-highlight-mark] {
          animation: highlight-mark-spin 48s linear infinite;
        }
      }

      @keyframes highlight-mark-spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
    </style>

    <script>
      import gsap from "gsap";

      // Homepage-only hero entrance sequence, GSAP core (no ScrollTrigger) —
      // one orchestrated moment on load rather than scroll-linked reveals on
      // every section.
      //
      // Deliberately NOT using gsap.matchMedia() here: its .add() callback
      // only fires while the given query currently matches (verified against
      // gsap@3.15.0 — a query that's false at call time never invokes its
      // callback at all, silently). matchMedia is the right tool when you
      // need re-registration on resize; a one-shot reduced-motion check on
      // load is simpler and more reliably done with a plain matchMedia read.
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const duration = reduceMotion ? 0 : 0.7;
      const ease = "power2.out";

      const tl = gsap.timeline({ defaults: { duration, ease } });

      // Background triangle settles in alongside the copy (position 0 —
      // same start time), not before or after it, so it reads as one
      // combined entrance rather than the shape animating on its own.
      const heroTriangle = document.querySelector(
        '[data-anim="hero-triangle"]',
      );
      if (heroTriangle) {
        tl.from(
          heroTriangle,
          {
            opacity: 0,
            scale: 0.92,
            duration: reduceMotion ? 0 : 1.1,
            ease: "power2.out",
          },
          0,
        );
      }

      const copyChildren = document.querySelectorAll(
        '[data-anim="hero-copy"] > *',
      );
      if (copyChildren.length) {
        tl.from(copyChildren, { y: 20, opacity: 0, stagger: 0.1 });
      }

      const heroImage = document.querySelector('[data-anim="hero-image"]');
      if (heroImage) {
        tl.from(
          heroImage,
          { y: 20, opacity: 0, scale: 0.98 },
          reduceMotion ? undefined : "<0.1",
        );
      }

      // Cursor-following green glow in the hero: --mx/--my track the pointer
      // (px, relative to the zone's own box) and feed the glow's radial-
      // gradient position. The fade in/out itself is pure CSS
      // (group-hover:opacity-*) — this only updates position.
      const spotlightZone = document.querySelector("[data-spotlight-zone]");
      const glow = spotlightZone?.querySelector("[data-cursor-glow]");
      if (spotlightZone instanceof HTMLElement && glow instanceof HTMLElement) {
        spotlightZone.addEventListener("pointermove", (event) => {
          const rect = spotlightZone.getBoundingClientRect();
          glow.style.setProperty("--mx", `${event.clientX - rect.left}px`);
          glow.style.setProperty("--my", `${event.clientY - rect.top}px`);
        });
      }

      // Scroll-triggered reveal for [data-reveal] rows (currently just
      // the Solutions list) — fades/slides in the first time each row
      // crosses into view, then stops watching it. Separate from the
      // GSAP timeline above: that's a one-shot load animation for the
      // hero; this is IntersectionObserver + a plain CSS transition
      // (opacity/translate, toggled via .is-visible), since a simple
      // per-element "reveal once" doesn't need a timeline library.
      const revealTargets = document.querySelectorAll("[data-reveal]");
      if (revealTargets.length) {
        if (reduceMotion) {
          revealTargets.forEach((el) => el.classList.add("is-visible"));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  revealObserver.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
          );
          revealTargets.forEach((el) => revealObserver.observe(el));
        }
      }
    </script>
  </div></Layout
>
