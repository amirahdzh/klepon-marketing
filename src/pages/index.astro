        </div>
      </div>
    </section>

    <!-- <section class="px-8 py-16">
      <div class="mx-auto mb-14 max-w-6xl text-left">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          Solutions
        </span>
        <span class="mb-4 block h-1 w-12 bg-brand-amber" aria-hidden="true"
        ></span>
        <h2
          class="mb-3 max-w-lg text-[2rem] font-extrabold leading-[1.3] text-brand-navy"
        >
          Practical Fire Design Tools Built by <span
            class="text-brand-green-700">Engineers</span
          >, for <span class="text-brand-green-700">Engineers</span>.
        </h2>
        <p class="max-w-2xl text-body leading-[1.9] text-brand-navy/75">
          Created and refined by people who work with fire protection design
          every day, KLEPON solutions are built around real project workflows,
          not generic software assumptions.
        </p>
      </div>

      <div class="mx-auto flex max-w-5xl flex-col gap-12">
        {
          solutions.map((s, i) => (
            <div
              data-reveal
              class={`flex flex-col items-center gap-6 lg:gap-10 ${
                i % 2 === 1 ? "lg:flex-row-reverse" : "lg:flex-row"
              }`}
            >
              <div
                style={`transition-delay: ${i * 100}ms`}
                class={`w-full transition-all duration-700 ease-out [.is-visible_&]:translate-x-0 [.is-visible_&]:translate-y-0 [.is-visible_&]:opacity-100 lg:w-[46%] ${revealDirections[i % revealDirections.length]}`}
              >
                <div class="flex items-center justify-center rounded-[2rem] p-6">
                  <img
                    src={s.image}
                    alt={s.title}
                    class="aspect-[5/4] w-full max-w-[22rem] object-contain"
                  />
                </div>
              </div>
              <div
                style={`transition-delay: ${i * 100}ms`}
                class={`w-full transition-all duration-700 ease-out [.is-visible_&]:translate-x-0 [.is-visible_&]:translate-y-0 [.is-visible_&]:opacity-100 lg:w-[54%] ${revealDirections[i % revealDirections.length]}`}
              >
                <div class="mb-2 text-xl font-bold leading-[1.25] text-brand-navy lg:text-[1.75rem]">
                  {s.title}
                </div>
                <p class="m-0 max-w-[56ch] text-base leading-[1.7] text-brand-navy/70 lg:text-lg">
                  {s.body}
                </p>
                <Button
                  href="/tools"
                  variant="primary"
                  size="sm"
                  class="mt-4 text-white no-underline hover:text-white hover:no-underline"
                >
                  Learn More
                </Button>
              </div>
            </div>
          ))
        }
      </div>
    </section> -->

    <section class="bg-white px-8 py-16">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          WORKFLOW
        </span>
        <span
          class="mx-auto mb-4 block h-1 w-12 bg-brand-amber"
          aria-hidden="true"></span>
        <h2 class="mb-4 text-[2rem] font-extrabold text-brand-navy">
          From Revit to Reality
        </h2>
        <p class="mb-3.5 text-body leading-relaxed text-brand-navy/75">
          Created and refined by people who work with fire protection design
          every day, KLEPON solutions are built around real project workflows,
          not generic software assumptions.
        </p>
        <!-- <p class="text-body leading-relaxed text-brand-navy/75">
          From setting up a design area through running the calculation,
          generating a P&amp;ID drafting view, and tracking spools through
          fabrication, every stage works from that same connected model — so
          information stays in sync as the design changes, without re-entering
          it into another tool.
        </p> -->
      </div>

      {
        /* Single column, full width — a hub-and-spoke layout with this
         much horizontal spread needs more room than half a 12-col row,
         confirmed by two earlier attempts that both ended up overlapping
         inside that narrower column.

         Hidden below md: fit() has no floor, so on a ~360px phone the
         1180×760 stage would scale to ~0.25× — an 8px title, ~3px item
         pills. Not "cramped," genuinely unreadable. Below md, the same
         capabilityWheel data renders as a plain stacked list instead
         (right after this element) — matching how Solutions/features
         already collapse to one column on mobile elsewhere on this
         page, rather than forcing the radial layout to survive a width
         it was never going to survive. */
      }
      <div
        data-reveal
        id="wheel-frame"
        class="wheel-frame mx-auto hidden max-w-5xl md:block"
      >
        <div id="wheel-scaler" class="wheel-scaler">
          <div id="wheel-stage" class="wheel-stage">
            <svg
              id="wheel-svg"
              viewBox="0 0 1180 760"
              class="wheel-svg"
              aria-hidden="true"
            >
              <g id="wheel-rings">
                {
                  wheelRings.map((ring) => (
                    <path
                      class="wheel-ring"
                      d={ring.d}
                      fill="none"
                      stroke={ring.color}
                    />
                  ))
                }
              </g>
              <g id="wheel-conns"></g>
              <g id="wheel-dots"></g>

              <circle class="wheel-hubdisc" cx="590" cy="380" r="140"></circle>

              {
                /* Small pipe-and-node illustration inside the hub disc,
                 recolored to the site's green instead of the reference's
                 fire-red — same coordinates as the reference, just
                 recolored. */
              }
              <g class="wheel-pipe">
                <path d="M 545 332 H 636"></path>
                <path d="M 590 332 V 452"></path>
                <path d="M 545 332 V 386 H 516"></path>
                <path d="M 636 332 V 404 H 668"></path>
                <path d="M 590 452 H 628 V 428"></path>
              </g>
              <g class="wheel-nodes">
                <rect x="583" y="325" width="14" height="14" rx="2"></rect>
                <rect x="538" y="325" width="14" height="14" rx="2"></rect>
                <rect x="629" y="325" width="14" height="14" rx="2"></rect>
                <rect x="583" y="445" width="14" height="14" rx="2"></rect>
              </g>
            </svg>

            <div
              id="wheel-hub"
              class="wheel-hub"
              style="left:590px; top:380px;"
            >
              R
            </div>

            {
              capabilityWheel.map((node) => (
                <div
                  class={`wheel-card ${node.big ? "wheel-card-lg" : ""}`}
                  data-id={node.id}
                  data-angle={node.angle}
                  tabindex="0"
                >
                  {node.eyebrow && (
                    <p class="wheel-card-eyebrow">{node.eyebrow}</p>
                  )}
                  <h3 class="wheel-card-title">{node.title}</h3>
                  <ul class="wheel-card-items">
                    {node.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }

            {
              /* The colored tag rides the connector as its own floating
               badge (matching the reference's separately-positioned .tag
               div), not nested inside the card — positioned by the same
               runtime layout pass. */
            }
            {
              capabilityWheel.map((node) => (
                <div
                  class="wheel-tag"
                  data-for={node.id}
                  style={`background-color: ${WHEEL_GREEN}`}
                >
                  {node.tag}
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {
        /* Mobile equivalent of the wheel above — same capabilityWheel
         data, plain stacked cards, real font sizes, no scaling math. */
      }
      <div class="mx-auto flex max-w-xl flex-col gap-4 md:hidden">
        {
          capabilityWheel.map((node, i) => (
            <div
              data-reveal
              style={`transition-delay: ${i * 80}ms`}
              class="rounded-3xl border border-brand-navy/10 bg-white p-5 opacity-0 translate-y-6 shadow-sm transition-all duration-700 ease-out [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100"
            >
              <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                  {node.eyebrow && (
                    <p class="mb-1 text-[10px] font-bold uppercase leading-tight tracking-wide text-brand-navy/40">
                      {node.eyebrow}
                    </p>
                  )}
                  <h3 class="text-lg font-black uppercase leading-tight text-brand-navy">
                    {node.title}
                  </h3>
                </div>
                <span
                  class="shrink-0 whitespace-nowrap rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white"
                  style={`background-color: ${WHEEL_GREEN}`}
                >
                  {node.tag}
