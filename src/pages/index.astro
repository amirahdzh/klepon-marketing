---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import HalftoneDots from "../components/HalftoneDots.astro";
import KleponMark from "../components/KleponMark.astro";
import KleponTriangle from "../components/KleponTriangle.astro";

// Use only horizontal motion for the Solutions rows so the reveal stays
// consistent and directional without the vertical variants.
const revealDirections = [
  "opacity-0 -translate-x-10",
  "opacity-0 translate-x-10",
];

const solutions = [
  {
    title: "Fire System Modelling Tools",
    body: "Create, manage, and improve Revit-based fire protection models with tools designed to reduce repetitive actions, improve consistency, and speed up daily modelling work.",
    image: "/Fire system modeling tools.png",
  },
  {
    title: "Interactive Hydraulic Calculations",
    body: "Work with model-based hydraulic data, demand points, pipe networks, and calculation-ready information in a more visual and connected workflow.",
    image: "/Interactive Hydraulic Calculations.png",
  },
  {
    title: "Pipe Fabrication and Procurement Tools",
    body: "Generate structured pipe data, prefab outputs, material lists, and procurement information directly from the model to support construction-ready delivery.",
    image: "/Pipe fabrication and procurement tools.png",
  },
  {
    title: "P&ID Generator",
    body: "Create clearer system diagrams and project documentation using automated workflows linked to real engineering data.",
    image: "/P&ID generator.png",
  },
];

// Bento layout: features[0] is the big full-width card, features[1..3]
// sit in the row below. Images are existing project assets standing in
// for real product screenshots.
const features = [
  {
    number: "01",
    numberColor: "text-brand-green-700",
    icon: '<path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/>',
    title: "One model, not a re-entered one",
    body: "Sprinkler, pipe, and source data used in the calculation are the same parameters live on your Revit elements — no separate spreadsheet or import step to keep in sync as the design changes.",
    image: "/feature.jpg",
  },
  {
    number: "02",
    numberColor: "text-brand-green-700",
    icon: '<path d="M12 3a9 9 0 0 0-9 9c0 2.4.94 4.57 2.46 6.18"/><path d="M12 3a9 9 0 0 1 9 9c0 2.4-.94 4.57-2.46 6.18"/><path d="M12 12 8 15"/><circle cx="12" cy="12" r="1"/>',
    title: "Two calculation modes, one engine",
    body: "Design what your source needs to supply, or verify a real pump or city-supply curve against your demand — without switching tools between design and verification.",
    image: "/Interactive Hydraulic Calculations.png",
  },
  {
    number: "03",
    numberColor: "text-brand-green-700",
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
    title: "Guardrails built into the design",
    body: "Automatic dead-end and critical-area screening, plus mark-collision checks during prefab numbering, are built to catch the network mistakes that are easy to miss by eye.",
    image: "/Fire system modeling tools.png",
  },
  {
    number: "04",
    numberColor: "text-brand-green-700",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/>',
    title: "From calculation to drawing",
    body: "The same design area can produce a PDF calculation report, an auto-generated P&ID drafting view, and — with the Build package — a numbered, trackable set of prefab spools.",
    image: "/P&ID generator.png",
  },
];

// Hub-and-spoke capability wheel for "Single Source of Truth", replacing
// the old wordcloud.png. Positioning is done at RUNTIME by a small
// vanilla-JS layout pass at the bottom of this file (no GSAP — the
// reveal still runs through the site's existing IntersectionObserver
// convention), ported directly from the reference prototype's own
// layout()/fit() functions: measure each card's real rendered size,
// anchor it along its angle at CARD_R, dock the connector to whichever
// edge faces the hub, and scale the whole 1180×760 stage to the
// container's width. Two earlier build-time-only attempts at
// approximating this with precomputed percentages produced overlapping
// cards once actually screenshotted — the reference avoids that by using
// each card's true measured box, which only exists in the browser.
//
// NOTE: Coordination, Procurement, Installation, As-Built & Handover, and
// the QR Code Generator line item reintroduce claims this session's own
// Confirm-Before-Publish review flagged as unverified against the plugin
// source (Procurement/Installation/Coordination/Handover) or explicitly
// not reachable by a customer today (QR Code Generator's ribbon button is
// commented out of App.cs). Kept per an explicit decision when asked,
// not an oversight — revisit if that decision changes.
// One green everywhere across the 6 repeated elements in this component
// (cards, tags, dots) — matches --color-brand-green-600, the same token
// every other green on this page resolves to (buttons, the "Engineers"
// text accent, the triangle/mark). Previously mixed in --color-brand-amber
// and --color-brand-green-300 (a much lighter mint, #8fdfb9 vs #11a46e)
// across those repeated elements for visual variety — caught on review as
// reading like a different green, not a deliberate accent. The 3 orbit
// rings are the one deliberate exception: see wheelRings below.
const WHEEL_GREEN = "var(--color-brand-green-600)";

// title/eyebrow/items/tag/angle are the reference's own copy, used as-
// is. angle: evenly spaced (60° apart) rather than the reference's own
// clustered angles (-90/-40/8/52/128/-140, spanning only ~142° on one
// side) — a deliberate simplification for a more symmetric layout.
// big: the reference's .card.lg.
const capabilityWheel = [
  {
    id: "design",
    title: "Fire System Design",
    eyebrow: "Hydraulic Calculation",
    items: ["Design tools", "Utility tools", "Modeling tools"],
    tag: "Automated",
    angle: -90,
    big: true,
  },
  {
    id: "coord",
    title: "Coordination",
    items: ["Families-to-site accuracy", "Auto-clash fix (coming soon)"],
    tag: "Collaboration",
    angle: -30,
  },
  {
    id: "proc",
    title: "Procurement",
    items: ["Automated material listing", "Preset material specifications"],
    tag: "Connected",
    angle: 30,
  },
  {
    id: "prefab",
    title: "Pre-Fabrication",
    items: ["Full automated prefab tools", "Automated pipe spool sheets"],
    tag: "Time saving",
    angle: 90,
  },
  {
    id: "install",
    title: "Installation",
    items: ["QR code generator", "Automated pipe spool tagging"],
    tag: "Accurate",
    angle: 150,
  },
  {
    id: "asbuilt",
    title: "As-Built & Handover",
    eyebrow: "Klepon Auto-As-Built Scan Conversion",
    items: ["Klepon P&ID Generator"],
    tag: "Up to date",
    angle: 210,
  },
];

// Same three orbit-arc radii/spans as the reference (150/170/190 around
// hub 590,380), plain SVG paths since they're static — only the cards/
// connectors/dots/tags need runtime positioning.
const wheelPolar = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [590 + r * Math.cos(a), 380 + r * Math.sin(a)] as const;
};
const wheelArc = (r: number, a0: number, a1: number) => {
  const [x0, y0] = wheelPolar(r, a0);
  const [x1, y1] = wheelPolar(r, a1);
  const large = Math.abs(a1 - a0) > 180 ? 1 : 0;
  const sweep = a1 > a0 ? 1 : 0;
  return `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${r} ${r} 0 ${large} ${sweep} ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};
// Middle ring is amber, not green — a small deliberate accent breaking
// up the 3 concentric rings, echoing the sparing amber touches used
// elsewhere on the page (underline bars, the "smarter" highlight).
const wheelRings = [
  { d: wheelArc(150, -118, 150), color: WHEEL_GREEN },
  { d: wheelArc(170, 40, 268), color: "var(--color-brand-amber)" },
  { d: wheelArc(190, 150, 392), color: WHEEL_GREEN },
];

const downloadIcon =
  '<path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path>';
const arrowIcon = '<path d="M5 12h12"></path><path d="m13 6 6 6-6 6"></path>';
---

<Layout title="KLEPON — Fire Design Tools for Revit">
  <div class="w-full bg-brand-bg font-brand">
    <Nav />

    <section id="hero" class="px-0 pb-0 pt-0">
      <div
        class="relative flex min-h-[95vh] flex-col justify-center overflow-hidden rounded-none bg-brand-navy px-8 pb-8 pt-24 sm:px-10 sm:pb-12 sm:pt-28 lg:px-14 lg:pb-16 lg:pt-32"
