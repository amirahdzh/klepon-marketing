              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={arrowIcon}
            />
          </a>
        </div>
      </div>
    </section>

    <section
      data-reveal
      class="px-8 py-16 opacity-0 translate-y-8 transition-all duration-700 ease-out [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100"
    >
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-brand-green-700"
        >
          See It In Revit
        </span>
        <span
          class="mx-auto mb-4 block h-1 w-12 bg-brand-amber"
          aria-hidden="true"></span>
        <h2
          class="mb-3 text-[2rem] font-extrabold leading-[1.3] text-brand-navy"
