---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import AboutCTA from "../components/AboutCTA.astro";
import Footer from "../components/Footer.astro";

const heroFacts = [
  {
    label: "Founded",
    value: "Born from Safe Engineers & Dwi Highbrow Engineering",
    icon: '<path d="M3 21h18"/><path d="M6 21V9l6-4 6 4v12"/><path d="M10 21v-6h4v6"/>',
  },
  {
    label: "Headquarters",
    value: "Engineering and development based in Europe",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/>',
  },
  {
    label: "Team",
    value: "Fire protection engineers and software developers",
    icon: '<circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0-3-3.87"/>',
  },
];

const values = [
  {
    title: "Built by Practitioners",
    body: "Every tool is designed and tested by engineers who use it on live fire protection projects.",
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    title: "Practical Over Flashy",
    body: "We prioritize features that save real hours on real projects over novelty for its own sake.",
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    title: "Data You Can Trust",
    body: "Structured, model-based data reduces rework and keeps every output consistent, end to end.",
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
  },
  {
    title: "Long-Term Partnership",
    body: "We build tools alongside our clients' workflows, not around a one-size-fits-all product.",
    icon: '<circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M21 21v-2a4 4 0 0 0-3-3.87"/>',
  },
];

const offices = [
  {
    region: "Europe",
    tag: "Headquarters",
    body: "Home to our core engineering and development team, where KLEPON tools are designed, built, and tested.",
  },
  {
    region: "Singapore",
    tag: "Regional Office",
    body: "Supporting fire protection projects and clients across Southeast Asia.",
  },
  {
    region: "Australia",
    tag: "Regional Office",
    body: "Delivering fire protection design support and tool adoption across ANZ.",
  },
];
---

<Layout
  title="Company — KLEPON"
  description="KLEPON is engineering-led software for fire protection teams, built by the practitioners behind Safe Engineers and Dwi Highbrow Engineering."
>
  <div class="mx-auto max-w-7xl">
    <Nav />

    <section
      class="grid grid-cols-1 items-center gap-10 px-8 pb-16 pt-14 lg:grid-cols-12 lg:gap-x-14"
    >
      <div class="lg:col-span-6">
        <span
          class="mb-2.5 block text-label font-semibold uppercase tracking-wide text-accent-700"
        >
          Company
        </span>
        <h1 class="mb-5 text-[2.75rem] leading-[1.1]">
          Engineering-Led Software for <span class="text-accent-700"
            >Fire Protection Teams</span
          >
        </h1>
        <p class="max-w-[56ch] text-base leading-relaxed text-text/85">
          KLEPON is built by the same engineers who use it — a company shaped
          by decades of hands-on fire protection project work, not a generic
          software vendor.
        </p>
      </div>

      <div class="lg:col-span-6">
        <div class="relative overflow-hidden rounded-[2rem] bg-surface p-6 shadow-sm sm:p-8">
          <svg
            class="pointer-events-none absolute -right-10 -top-10 h-56 w-56 text-accent-700/[0.07]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          <ul class="relative flex flex-col gap-6">
            {
              heroFacts.map((f) => (
                <li class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-divider bg-bg shadow-sm">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="var(--color-accent-700)"
                      stroke-width="1.5"
                      aria-hidden="true"
                      set:html={f.icon}
                    />
                  </span>
                  <span>
                    <span class="block text-micro font-semibold uppercase tracking-wide text-accent-700">
                      {f.label}
                    </span>
                    <span class="block text-body leading-snug">{f.value}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span
          class="mb-2.5 block text-label font-semibold uppercase tracking-wide text-accent-700"
        >
          What We Value
        </span>
        <h2 class="mb-3 text-[2rem]">
          How We Build KLEPON
        </h2>
        <p class="text-body leading-relaxed text-text/85">
          The same principles that guide our engineering work also guide how
          we build software.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="card flex flex-col items-start gap-2 p-5 transition-shadow duration-200 hover:shadow-elev-md">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-accent-700)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={v.icon}
              />
              <div class="mt-1.5 font-heading text-lg font-semibold">
                {v.title}
              </div>
              <p class="m-0 flex-1 text-label opacity-80">{v.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span
          class="mb-2.5 block text-label font-semibold uppercase tracking-wide text-accent-700"
        >
          Where We Work
        </span>
        <h2 class="text-[2rem]">
          Global Reach, Engineering Roots
        </h2>
      </div>

      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3">
        {
          offices.map((o) => (
            <div class="card flex flex-col gap-2 p-6 text-center">
              <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-2xl bg-accent-100">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-accent-700)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="10" r="3" />
                  <path d="M12 21s7-6.5 7-11a7 7 0 0 0-14 0c0 4.5 7 11 7 11z" />
                </svg>
              </span>
              <div class="mt-1 text-micro font-semibold uppercase tracking-wide text-accent-700">
                {o.tag}
              </div>
              <div class="font-heading text-lg font-semibold">{o.region}</div>
              <p class="m-0 text-label leading-relaxed opacity-80">{o.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <AboutCTA />
    <Footer />
  </div>
</Layout>
