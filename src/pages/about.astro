---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import AboutCTA from "../components/AboutCTA.astro";
import Footer from "../components/Footer.astro";
import aboutHeroImg from "../assets/img/about-hero.jpg";

const targetIcon =
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>';

const stats = [
  { value: 150, suffix: "+", label: "Projects executed" },
  { value: 40, suffix: "+", label: "Clients served" },
  { value: 50000, suffix: "+", label: "Hours of design, modeling & drafting" },
];

// PLACEHOLDER — real name, title/credential, bio, and photo needed before
// this ships. Do not invent specifics for a real person; every bracketed
// field below must be replaced with verified information. Single-person
// spotlight layout, not a grid — revisit if a second person joins.
const leader = {
  name: "[Full Name]",
  title: "[Role — e.g. Fire Protection Engineer]",
  credential: "[Certification / years in the field]",
  bio: "[Two or three sentences on their background, notable projects, and standing in the fire protection industry — what makes them a recognized figure in the field.]",
};

const personIcon =
  '<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/>';

// The founding-to-today narrative as a chronological progression rather
// than a flat paragraph dump — titles below are presentational labels for
// grouping, not new claims; the body text is the user-provided copy
// verbatim (split only at existing sentence/paragraph boundaries).
const timelineSteps = [
  {
    title: "Years in the field",
    body: "Over the years, we have provided design and engineering support for many clients, gaining thousands of hours of hands-on project experience in real-world construction environments.",
    icon: '<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect x="2" y="7" width="20" height="14" rx="2"/>',
  },
  {
    title: "The turning point",
    body: "That experience taught us one clear lesson: engineering teams need better tools.",
    icon: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.71.71 1.21 1.33 1.41 2.5"/>',
    emphasis: true,
  },
  {
    title: "Building our own tools",
    body: "Through our daily project work, we continuously searched for ways to reduce repetitive tasks, improve accuracy, speed up documentation, and deliver more reliable results. First by using other tools available on the market, whereafter step by step, we began developing our own internal tools to automate routine workflows and improve the quality of our output.",
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    title: "KLEPON is born",
    body: "As these tools helped us deliver results faster and more efficiently than conventional 3D modelling workflows, the idea behind KLEPON was born. KLEPON focuses on developing practical, high-performance tools for engineering and construction professionals — tools created from the ground up by people who understand the work because it is part of our daily routine.",
    icon: '<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>',
  },
];
---

<Layout
  title="About — KLEPON"
  description="KLEPON was founded from the long-standing collaboration between Safe Engineers and Dwi Highbrow Engineering, bringing decades of Revit-based fire protection engineering experience into practical software tools."
>
  <div class="mx-auto max-w-7xl">
    <Nav />

    <section
      class="relative overflow-hidden pt-24 sm:pt-28 lg:flex lg:min-h-[600px] lg:items-center lg:pt-8"
    >
      <div class="relative mb-8 lg:absolute lg:inset-0 lg:mb-0">
        <Image
          src={aboutHeroImg}
          alt=""
          width={1400}
          class="h-56 w-full rounded-lg object-cover sm:h-72 lg:h-full lg:rounded-none"
        />
        <div
          class="pointer-events-none hidden lg:block lg:absolute lg:inset-0"
          style="background: linear-gradient(to right, var(--color-bg) 0%, var(--color-bg) 38%, color-mix(in srgb, var(--color-bg) 15%, transparent) 62%, transparent 80%);"
          aria-hidden="true"
        >
        </div>
      </div>

      <div class="relative px-8 pb-16 lg:py-24">
        <div class="max-w-xl">
          <div class="mb-5">
            <span
              class="text-label font-bold uppercase tracking-wide text-accent-700"
            >
              About Us
            </span>
            <span class="mt-2 block h-0.5 w-9 bg-accent-700" aria-hidden="true">
            </span>
          </div>

          <h1
            class="mb-6 text-[2.5rem] font-extrabold leading-[1.15] tracking-tight text-text sm:text-[2.75rem]"
          >
            Built from real fire protection engineering work.
          </h1>

          <p class="mb-4 text-body leading-relaxed text-text/85">
            KLEPON was born in 2021 from the collaboration between Safe
            Engineers and Dwi Highbrow Engineering — two companies with a
            proven track record delivering fire protection engineering
            projects across Europe, Singapore, and Australia.
          </p>
          <p class="mb-8 text-body leading-relaxed text-text/85">
            Our background is deeply rooted in Revit-based fire system engineering
            and design, including approval(s), hydraulic calculations, fire
            studies, 3D modelling, coordination and clash resolving, material
            lists, prefabrication and installation drawings, schedules, and
            technical details.
          </p>

          <div
            data-stats-row
            class="mb-8 grid grid-cols-1 gap-x-6 gap-y-6 border-t border-divider pt-7 sm:grid-cols-3"
          >
            {
              stats.map((stat) => (
                <div>
                  <div
                    data-stat-count={stat.value}
                    data-stat-suffix={stat.suffix}
                    class="font-heading text-4xl font-extrabold tabular-nums text-accent-700 sm:text-5xl"
                  >
                    {stat.value.toLocaleString()}
                    {stat.suffix}
                  </div>
                  <div class="mt-1 text-micro-sm uppercase tracking-wide text-text/60">
                    {stat.label}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <Button variant="primary" size="xl" href="/tools">
              Explore Our Tools
            </Button>
          </div>
        </div>
      </div>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-accent-700"
        >
          Our Story
        </span>
        <h2 class="text-[2rem] font-extrabold leading-[1.3] text-text">
          Engineering teams need better tools
        </h2>
      </div>

      <ol class="relative mx-auto flex max-w-2xl flex-col gap-10">
        <div
          class="absolute bottom-6 left-6 top-6 w-px bg-divider"
          aria-hidden="true"
        >
        </div>
        {
          timelineSteps.map((step) => (
            <li class="relative flex gap-5">
              <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-divider bg-bg shadow-sm">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-accent-700)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={step.icon}
                />
              </span>
              <div class="pt-2">
                <h3 class="mb-1.5 text-lg font-bold text-text">{step.title}</h3>
                <p
                  class={
                    step.emphasis
                      ? "m-0 max-w-[55ch] text-lg font-medium leading-relaxed text-accent-700"
                      : "m-0 max-w-[55ch] text-body leading-relaxed text-text/75"
                  }
                >
                  {step.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <span
          class="mb-2.5 block text-label font-bold uppercase tracking-wide text-accent-700"
        >
          Leadership
        </span>
        <h2 class="text-[2rem] font-extrabold leading-[1.3] text-text">
          A recognized name in fire protection engineering
        </h2>
      </div>

      <div class="mx-auto max-w-4xl overflow-hidden rounded-[2.5rem] bg-white shadow-elev-sm lg:flex lg:items-stretch">
        <div class="flex aspect-[4/3] items-center justify-center bg-surface lg:aspect-auto lg:w-72 lg:shrink-0">
          <svg
            width="56"
            height="56"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-accent-700)"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={personIcon}
          />
        </div>
        <div class="p-8 sm:p-10 lg:flex lg:flex-1 lg:flex-col lg:justify-center">
          <div class="font-heading text-2xl font-bold text-text">
            {leader.name}
          </div>
          <div class="mt-1 text-label text-accent-700">{leader.title}</div>
          <div class="mt-1 text-micro-sm uppercase tracking-wide text-text/50">
            {leader.credential}
          </div>
          <p class="mt-4 max-w-[60ch] text-body leading-relaxed text-text/75">
            {leader.bio}
          </p>
        </div>
      </div>
    </section>

    <section class="px-8 pb-16">
      <div class="rounded-[2.5rem] bg-accent-100 p-8 sm:p-10">
        <div
          class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-x-10 lg:items-center"
        >
          <div class="lg:col-span-7">
            <div class="mb-4 lg:flex lg:items-center lg:gap-6">
              <svg
                width="80"
                height="80"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-accent-700)"
                stroke-width="1.5"
                aria-hidden="true"
                set:html={targetIcon}
              />

              <div class="lg:flex-1">
                <div class="mb-2">
                  <span
                    class="text-label font-bold uppercase tracking-wide text-accent-700"
                    >Our Goal Is Simple</span
                  >
                </div>
                <p class="m-0 text-[1rem] leading-[1.25] tracking-wide">
                  To build better tools than those currently available in the
                  market and set a leading standard for fire system design
                  worldwide.
                </p>
              </div>
            </div>
          </div>

          <div
            class="lg:col-span-5 lg:flex lg:items-center lg:border-l lg:border-divider lg:pl-8"
          >
            <p class="m-0 text-body font-medium leading-relaxed text-text/85">
              KLEPON helps engineering work to be done fast and efficient with
              tools you can trust.
            </p>
          </div>
        </div>
      </div>
    </section>

    <AboutCTA />
    <Footer />
  </div>

  <script>
    // Same one-shot matchMedia convention as the rest of the site's motion
    // (see DESIGN.md's "One-Shot Reduced-Motion Check") — gsap.matchMedia()
    // only fires its callback while the query currently matches true, so a
    // naive reduced-motion gate there silently never runs for anyone else.
    // Reading the boolean directly and branching on it is the fix, and this
    // count-up is simple enough not to need gsap at all.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const statEls = document.querySelectorAll<HTMLElement>("[data-stat-count]");
    if (statEls.length && !reduceMotion) {
      const animateCount = (el: HTMLElement) => {
        const target = Number(el.dataset.statCount);
        const suffix = el.dataset.statSuffix ?? "";
        const duration = 1200;
        const start = performance.now();

        const step = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = Math.round(target * eased).toLocaleString() + suffix;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const statObserver = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              animateCount(entry.target as HTMLElement);
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.5 },
      );
      statEls.forEach((el) => statObserver.observe(el));
    }
  </script>
</Layout>
