---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import AboutCTA from "../components/AboutCTA.astro";
import Footer from "../components/Footer.astro";

const bookIcon =
  '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>';

const philosophyValues = [
  {
    title: "Built by Engineers",
    body: "Every tool is created by engineers who use it every day — we understand the challenges because we live them.",
    icon: '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  },
  {
    title: "Practical Workflows",
    body: "We focus on reducing repetitive tasks and simplifying complex processes, so you can deliver faster with confidence.",
    icon: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  },
  {
    title: "Connected Data",
    body: "One reliable data source flows across your drawings, calculations, schedules, and deliverables — reducing errors and rework.",
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
  },
  {
    title: "Long-Term Innovation",
    body: "We continue to refine our tools as project needs, standards, and technology evolve.",
    icon: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-4 4"/>',
  },
];

const points = [
  {
    title: "Developed from real projects",
    body: "Every tool comes from challenges we've faced on real fire protection engineering and construction projects.",
  },
  {
    title: "High performance & reliability",
    body: "Built to handle complex systems and large projects with accuracy and stability.",
  },
  {
    title: "Designed for productivity",
    body: "Practical workflows that help teams reduce repetitive tasks and deliver faster.",
  },
  {
    title: "Trusted by professionals",
    body: "Created for engineering and construction professionals who need tools they can rely on.",
  },
];

const targetIcon =
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>';
---

<Layout
  title="About — KLEPON"
  description="KLEPON was founded from the long-standing collaboration between Safe Engineers and Dwi Highbrow Engineering, bringing decades of Revit-based fire protection engineering experience into practical software tools."
>
  <div class="mx-auto max-w-7xl">
    <Nav />

    <section
      class="relative overflow-hidden lg:flex lg:min-h-[600px] lg:items-center"
    >
      <div class="relative mb-8 lg:absolute lg:inset-0 lg:mb-0">
        <img
          src="/hero.png"
          alt="Fire protection piping installed in a real project"
          class="h-56 w-full rounded-lg object-cover sm:h-72 lg:h-full lg:rounded-none"
        />
        <div
          class="pointer-events-none hidden lg:block lg:absolute lg:inset-0"
          style="background: linear-gradient(to right, var(--color-bg) 0%, var(--color-bg) 38%, color-mix(in srgb, var(--color-bg) 15%, transparent) 62%, transparent 80%);"
          aria-hidden="true"
        >
        </div>
      </div>

      <div class="relative px-8 pb-16 lg:py-24">
        <div class="max-w-xl">
          <div class="mb-5">
            <span
              class="text-label font-semibold uppercase tracking-wide text-accent-700"
            >
              Company / About KLEPON
            </span>
            <span class="mt-2 block h-0.5 w-9 bg-accent-700" aria-hidden="true">
            </span>
          </div>

          <h1
            class="mb-6 text-[2.5rem] font-semibold leading-[1.15] tracking-tight text-text sm:text-[3rem]"
          >
            Built from real fire protection engineering work.
          </h1>

          <p class="mb-4 text-body leading-relaxed text-text/85">
            KLEPON was founded from the long-standing collaboration between Safe
            Engineers and Dwi Highbrow Engineering — two companies with a proven
            track record of delivering hundreds of active fire protection
            engineering projects across Europe, Singapore, and Australia.
          </p>
          <p class="mb-8 text-body leading-relaxed text-text/85">
            Our background is deeply rooted in Revit-based fire system engineering
            and design, including approvals, hydraulic calculations, fire studies,
            3D modelling, coordination and clash resolution, material lists,
            prefabrication and installation drawings, schedules, and technical
            details.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <Button variant="primary" size="xl">Explore Our Tools</Button>
          </div>
        </div>
      </div>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <div class="mb-5 flex items-center gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl border border-divider bg-surface shadow-sm"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-accent-700)"
                stroke-width="1.5"
                aria-hidden="true"
                set:html={bookIcon}
              />
            </span>
            <h2 class="text-[2rem]">Our Story</h2>
          </div>

          <p class="mb-4 text-body leading-relaxed text-text/85">
            Our background is deeply rooted in Revit-based fire system
            engineering and design, including approvals, hydraulic
            calculations, fire studies, 3D modelling, coordination and clash
            resolution, material lists, prefabrication and installation
            drawings, schedules, and technical details.
          </p>
          <p class="mb-4 text-body leading-relaxed text-text/85">
            Over the years, we have provided design and engineering support
            for many clients, gaining thousands of hours of hands-on project
            experience in real-world construction environments.
          </p>
          <p class="m-0 text-body font-medium leading-relaxed text-accent-700">
            That experience taught us one clear lesson: engineering teams need
            better tools.
          </p>
        </div>

        <div class="lg:col-span-6">
          <img
            src="/hero.png"
            alt="Fire protection design data inside a Revit model"
            class="h-72 w-full rounded-lg object-cover object-[80%_30%] sm:h-80 lg:h-96"
          />
        </div>
      </div>
    </section>

    <hr class="mx-8 h-px border-0 bg-divider" />

    <section class="px-8 py-16">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span
          class="mb-2.5 block text-label font-semibold uppercase tracking-wide text-accent-700"
        >
          Our Philosophy
        </span>
        <h2 class="mb-3 text-[2rem]">
          Built on Real Experience, Driven by Purpose
        </h2>
        <p class="text-body leading-relaxed text-text/85">
          KLEPON develops practical, high-performance tools for engineering and
          construction professionals — tools created by engineers who use them every
          day.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          philosophyValues.map((v) => (
            <div class="flex flex-col items-start gap-2 rounded-2xl border border-divider bg-bg p-5 shadow-sm transition-shadow duration-200 hover:shadow-elev-md">
              <svg
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-accent-700)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={v.icon}
              />
              <div class="font-heading text-lg font-semibold">{v.title}</div>
              <p class="m-0 text-label leading-relaxed opacity-80">{v.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="px-8 pb-16">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-x-14">
        <div class="order-2 lg:order-1 lg:col-span-5">
          <div class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-surface shadow-sm">
            <svg
              class="pointer-events-none absolute inset-0 h-full w-full text-accent-700/[0.16]"
              viewBox="0 0 200 150"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              aria-hidden="true"
            >
              <path d="M20 130 L20 60 L70 60 L70 20 L140 20 L140 90 L180 90 L180 130 Z"
              ></path>
              <circle cx="20" cy="130" r="3" fill="currentColor"></circle>
              <circle cx="70" cy="60" r="3" fill="currentColor"></circle>
              <circle cx="140" cy="20" r="3" fill="currentColor"></circle>
              <circle cx="180" cy="90" r="3" fill="currentColor"></circle>
              <path d="M0 40 H200 M0 100 H200 M50 0 V150 M150 0 V150"
              ></path>
            </svg>
            <div
              class="relative flex h-full w-full items-center justify-center p-8 text-center"
            >
              <span
                class="font-heading text-[1.5rem] leading-snug text-accent-700"
              >
                Built for real project delivery
              </span>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2 lg:col-span-7">
          <span
            class="mb-2.5 block text-label font-semibold uppercase tracking-wide text-accent-700"
          >
            What Makes KLEPON Different
          </span>
          <h2 class="mb-6 text-[2rem]">
            Tools That Solve Real Problems
          </h2>

          <ul class="flex flex-col gap-5">
            {
              points.map((p) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-divider bg-surface text-accent-700">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <div>
                    <div class="mb-1 font-heading text-base font-semibold normal-case">
                      {p.title}
                    </div>
                    <p class="m-0 text-sm leading-relaxed text-text/80">
                      {p.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="px-8 pb-16">
      <div class="rounded-[2.5rem] bg-accent-100 p-8 sm:p-10">
        <div
          class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-x-10 lg:items-center"
        >
          <div class="lg:col-span-7">
            <div class="mb-4 lg:flex lg:items-center lg:gap-6">
              <svg
                width="80"
                height="80"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-accent-700)"
                stroke-width="1.5"
                aria-hidden="true"
                set:html={targetIcon}
              />

              <div class="lg:flex-1">
                <div class="mb-2">
                  <span
                    class="text-label font-semibold uppercase tracking-wide text-accent-700"
                    >Our Goal</span
                  >
                </div>
                <p class="m-0 text-[1rem] leading-[1.25] tracking-wide">
                  To build better tools than those currently available in the market
                  and set a leading standard for fire system design worldwide.
                </p>
              </div>
            </div>
          </div>

          <div
            class="lg:col-span-5 lg:flex lg:items-center lg:border-l lg:border-divider lg:pl-8"
          >
            <p class="m-0 text-body font-medium leading-relaxed text-text/85">
              KLEPON enables engineering work to be completed faster, more
              efficiently, and with confidence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <AboutCTA />
    <Footer />
  </div>
</Layout>
